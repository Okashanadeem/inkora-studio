# Inkora Studio Environment Template
# Copy this file to .env.local and populate the values

# Application
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NODE_ENV=development

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cloudflare R2
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_PUBLIC=inkora-catalog-public
R2_BUCKET_PRIVATE=inkora-artwork-private
R2_PUBLIC_BASE_URL=https://cdn.inkorastudio.com

# Resend
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM="Inkora Studio <orders@inkorastudio.com>"

# Upstash Redis
UPSTASH_REDIS_REST_URL=https://your-upstash-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# Payments & Operations
PAYMENT_PROVIDER_SECRETS={}
WEBHOOK_SIGNING_SECRETS={}
SENTRY_DSN=
CRON_SECRET=your-cron-secret-key
